# Nusxa oling: bu faylni ".env" nomi bilan saqlang va qiymatlarni o'zingiznikiga almashtiring.
# ".env" fayli git ga tushmaydi (.gitignore da).

# Supabase -> Project Settings -> API
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
# "anon" / "publishable" kalit (brauzerga berilishi mumkin, login bilan himoyalanadi)
SUPABASE_ANON_KEY=
# "service_role" / "secret" kalit - FAQAT server va maktab kompyuteridagi dastur uchun. Brauzerga bermang!
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI e'lon ----
# Ovoz yaratish (o'zbekcha Madina/Sardor ovozlari): Azure portal -> Speech service -> "Keys and Endpoint"
AZURE_SPEECH_KEY=
# O'sha sahifadagi "Location/Region", masalan: westeurope
AZURE_SPEECH_REGION=
# Matnni yaxshilash: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# ISTALGAN: Gemini modeli (standart: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# ISTALGAN: bazaga migratsiya (SQL) qo'llash uchun. Supabase -> Connect -> "Session pooler" URI
# (parol bilan). Faqat shu loyiha bazasiga ruxsat beradi. Bo'lsa, migratsiyalarni Claude o'zi qo'llaydi.
# SUPABASE_DB_URL=postgresql://postgres.XXXX:PAROL@aws-0-REGION.pooler.supabase.com:5432/postgres
